CIRCLEHOME = ../third_party/circle
STDLIB_SUPPORT = 1

MSXBARE_DEBUG_OVERLAY_DEFAULT ?= 1
MSXBARE_ENABLE_FMSX ?= 0
MSXBARE_TEST_TONE_DEFAULT ?= 0
MSXBARE_INITRAMFS_MOUNT ?= 1
MSXBARE_REQUIRE_CPIO_BIOS ?= 0
MSXBARE_DEBUG_OVERLAY_COMPACT ?= 1
MSXBARE_HARD_DISABLE_AUDIO ?= 0
MSXBARE_CARTA_ONLY ?= 0
MSXBARE_FMSX_AUDIO ?= 1
MSXBARE_EMBED_INITRAMFS ?= 0
MSXBARE_EMBEDDED_BIOS_PATH ?= ../roms/cbios/cbios_main_msx1_br.rom
MSXBARE_SUPPRESS_WARNINGS ?= 1
MSXBARE_FMSX_MSX1_TEXT80 ?= 1
MSXBARE_FMSX_RAMMAPPER_KB ?= 256
MSXBARE_FMSX_MEGARAM_KB ?= 256
MSXBARE_FMSX_MEGARAM_ENABLED ?= 1
MSXBARE_FMSX_CART_GUESS ?= 1
MSXBARE_FMSX_CARTA_MAPPER ?= 255
MSXBARE_FMSX_CARTB_MAPPER ?= 255
MSXBARE_FMSX_BOOT_PROFILE ?= 1
MSXBARE_BOOT_QUIET ?= 0
MSXBARE_DEFER_USB_INIT_FRAMES ?= 90
MSXBARE_DEFER_SETTINGS_LOAD_FRAMES ?= 0
MSXBARE_DEFER_INITRAMFS_FULL_MOUNT_FRAMES ?= 120
MSXBARE_SIZE_OPT ?= 1
MSXBARE_FMSX_BOOT_MINIMAL_STARTUP ?= 1
MSXBARE_ENABLE_DEBUG_OVERLAY ?= 1
MSXBARE_DEBUG_OVERLAY_STAGE ?= 1
MSXBARE_ENABLE_SETTINGS_SAVE_EXPERIMENTAL ?= 1
MSXBARE_MENU_DOUBLE_BUFFER ?= 1
MSXBARE_FMSX_SCC_BALANCE_PCT ?= 96
MSXBARE_FMSX_FMPAC_BALANCE_PCT ?= 100
MSXBARE_FMSX_FMPAC_ATTENUATION_PCT ?= 70
MSXBARE_FMSX_SYNC_SCC_FM_EVERY_8LINES ?= 1
MSXBARE_BUILD_BID ?=
MSXBARE_BUILD_OWNER ?=
MSXBARE_KERNEL_MAX_SIZE ?= 0x400000

CPPFLAGS += -DMSXBARE_DEBUG_OVERLAY_DEFAULT=$(MSXBARE_DEBUG_OVERLAY_DEFAULT)
CPPFLAGS += -DMSXBARE_ENABLE_FMSX=$(MSXBARE_ENABLE_FMSX)
CPPFLAGS += -DMSXBARE_TEST_TONE_DEFAULT=$(MSXBARE_TEST_TONE_DEFAULT)
CPPFLAGS += -DMSXBARE_INITRAMFS_MOUNT=$(MSXBARE_INITRAMFS_MOUNT)
CPPFLAGS += -DMSXBARE_REQUIRE_CPIO_BIOS=$(MSXBARE_REQUIRE_CPIO_BIOS)
CPPFLAGS += -DMSXBARE_DEBUG_OVERLAY_COMPACT=$(MSXBARE_DEBUG_OVERLAY_COMPACT)
CPPFLAGS += -DMSXBARE_HARD_DISABLE_AUDIO=$(MSXBARE_HARD_DISABLE_AUDIO)
CPPFLAGS += -DMSXBARE_CARTA_ONLY=$(MSXBARE_CARTA_ONLY)
CPPFLAGS += -DMSXBARE_FMSX_AUDIO=$(MSXBARE_FMSX_AUDIO)
CPPFLAGS += -DMSXBARE_EMBED_INITRAMFS=$(MSXBARE_EMBED_INITRAMFS)
CPPFLAGS += -DMSXBARE_EMBEDDED_BIOS_PATH=\"$(MSXBARE_EMBEDDED_BIOS_PATH)\"
CPPFLAGS += -DMSXBARE_SUPPRESS_WARNINGS=$(MSXBARE_SUPPRESS_WARNINGS)
CPPFLAGS += -DMSXBARE_FMSX_MSX1_TEXT80=$(MSXBARE_FMSX_MSX1_TEXT80)
CPPFLAGS += -DMSXBARE_FMSX_RAMMAPPER_KB=$(MSXBARE_FMSX_RAMMAPPER_KB)
CPPFLAGS += -DMSXBARE_FMSX_MEGARAM_KB=$(MSXBARE_FMSX_MEGARAM_KB)
CPPFLAGS += -DMSXBARE_FMSX_MEGARAM_ENABLED=$(MSXBARE_FMSX_MEGARAM_ENABLED)
CPPFLAGS += -DMSXBARE_FMSX_CART_GUESS=$(MSXBARE_FMSX_CART_GUESS)
CPPFLAGS += -DMSXBARE_FMSX_CARTA_MAPPER=$(MSXBARE_FMSX_CARTA_MAPPER)
CPPFLAGS += -DMSXBARE_FMSX_CARTB_MAPPER=$(MSXBARE_FMSX_CARTB_MAPPER)
CPPFLAGS += -DMSXBARE_FMSX_BOOT_PROFILE=$(MSXBARE_FMSX_BOOT_PROFILE)
CPPFLAGS += -DMSXBARE_BOOT_QUIET=$(MSXBARE_BOOT_QUIET)
CPPFLAGS += -DMSXBARE_DEFER_USB_INIT_FRAMES=$(MSXBARE_DEFER_USB_INIT_FRAMES)
CPPFLAGS += -DMSXBARE_DEFER_SETTINGS_LOAD_FRAMES=$(MSXBARE_DEFER_SETTINGS_LOAD_FRAMES)
CPPFLAGS += -DMSXBARE_DEFER_INITRAMFS_FULL_MOUNT_FRAMES=$(MSXBARE_DEFER_INITRAMFS_FULL_MOUNT_FRAMES)
CPPFLAGS += -DMSXBARE_SIZE_OPT=$(MSXBARE_SIZE_OPT)
CPPFLAGS += -DMSXBARE_FMSX_BOOT_MINIMAL_STARTUP=$(MSXBARE_FMSX_BOOT_MINIMAL_STARTUP)
CPPFLAGS += -DMSXBARE_ENABLE_DEBUG_OVERLAY=$(MSXBARE_ENABLE_DEBUG_OVERLAY)
CPPFLAGS += -DMSXBARE_DEBUG_OVERLAY_STAGE=$(MSXBARE_DEBUG_OVERLAY_STAGE)
CPPFLAGS += -DMSXBARE_ENABLE_SETTINGS_SAVE_EXPERIMENTAL=$(MSXBARE_ENABLE_SETTINGS_SAVE_EXPERIMENTAL)
CPPFLAGS += -DMSXBARE_MENU_DOUBLE_BUFFER=$(MSXBARE_MENU_DOUBLE_BUFFER)
CPPFLAGS += -DMSXBARE_FMSX_SCC_BALANCE_PCT=$(MSXBARE_FMSX_SCC_BALANCE_PCT)
CPPFLAGS += -DMSXBARE_FMSX_FMPAC_BALANCE_PCT=$(MSXBARE_FMSX_FMPAC_BALANCE_PCT)
CPPFLAGS += -DMSXBARE_FMSX_FMPAC_ATTENUATION_PCT=$(MSXBARE_FMSX_FMPAC_ATTENUATION_PCT)
CPPFLAGS += -DMSXBARE_FMSX_SYNC_SCC_FM_EVERY_8LINES=$(MSXBARE_FMSX_SYNC_SCC_FM_EVERY_8LINES)
CPPFLAGS += '-DMSXBARE_BUILD_BID="$(MSXBARE_BUILD_BID)"'
CPPFLAGS += '-DMSXBARE_BUILD_OWNER="$(MSXBARE_BUILD_OWNER)"'
CPPFLAGS += -DKERNEL_MAX_SIZE=$(MSXBARE_KERNEL_MAX_SIZE)

ifeq ($(MSXBARE_SUPPRESS_WARNINGS),1)
CFLAGS += -w
CXXFLAGS += -w
endif

ifeq ($(MSXBARE_ENABLE_FMSX),1)
CFLAGS += -DFMSX_BAREMETAL_NO_START_RUN
CFLAGS += -DFMSX_BAREMETAL_SKIP_DISK_OPEN
CFLAGS += -DFMSX_BAREMETAL_SKIP_FDC_RESET
CFLAGS += -DFMSX_BAREMETAL_SKIP_BIOS_PATCHES
ifeq ($(MSXBARE_FMSX_AUDIO),0)
CFLAGS += -DFMSX_BAREMETAL_SKIP_AUDIO_RESET
CFLAGS += -DFMSX_BAREMETAL_SKIP_AUDIO_RUNTIME
endif
CFLAGS += -DFMSX_BAREMETAL_SIMPLE_REFRESHBORDER
ifeq ($(MSXBARE_HARD_DISABLE_AUDIO),1)
CFLAGS += -DFMSX_BAREMETAL_HARD_DISABLE_AUDIO
endif
ifeq ($(MSXBARE_CARTA_ONLY),1)
CFLAGS += -DFMSX_BAREMETAL_CARTA_ONLY
endif
ifeq ($(MSXBARE_FMSX_BOOT_MINIMAL_STARTUP),1)
CFLAGS += -DFMSX_BAREMETAL_BOOT_MINIMAL_STARTUP
endif
CFLAGS += -DSKIP_STDIO_REDEFINES
CFLAGS += -I ./fmsx_compat -I ../third_party/fmsx -I ../third_party/fmsx/fMSX -I ../third_party/fmsx/EMULib -I ../third_party/fmsx/Z80
endif

ifeq ($(MSXBARE_SIZE_OPT),1)
CFLAGS += -Os -ffunction-sections -fdata-sections
CXXFLAGS += -Os -ffunction-sections -fdata-sections
LDFLAGS += --gc-sections
endif

OBJS = main.o kernel.o keyboard_input.o gfx_textbox.o viewport_screenshot.o combo_menu.o combo_menu_items.o media_catalog.o combo_file_browser.o combo_debug_overlay.o
OBJS += combo_locale.o combo_locale_pt.o combo_locale_en.o combo_locale_es.o

ifeq ($(MSXBARE_ENABLE_FMSX),1)
OBJS += fmsx_runtime.o fmsx_host_stubs.o fmsx_compat_stubs.o fmsx_libc_shim.o
OBJS += fmsx_virtual_fs.o fmsx_initramfs.o
OBJS += fmsx_carts_sha_fallback.o
OBJS += fmsx_embedded_initramfs.o
OBJS += fmsx_embedded_roms.o
OBJS += fmsx_upstream_msx.o fmsx_upstream_v9938.o fmsx_upstream_z80.o
OBJS += fmsx_upstream_sound.o fmsx_upstream_sha1.o
OBJS += fmsx_upstream_fdidisk.o
OBJS += fmsx_upstream_i8255.o fmsx_local_ym2413.o fmsx_upstream_ay8910.o fmsx_local_scc.o fmsx_upstream_wd1793.o
OBJS += fmsx_upstream_opll.o fmsx_upstream_wrapnukeykt.o
endif

LIBS = $(CIRCLEHOME)/lib/sound/libsound.a \
	   $(CIRCLEHOME)/lib/sched/libsched.a \
	   $(CIRCLEHOME)/lib/usb/libusb.a \
	   $(CIRCLEHOME)/lib/input/libinput.a \
	   $(CIRCLEHOME)/addon/SDCard/libsdcard.a \
	   $(CIRCLEHOME)/addon/fatfs/libfatfs.a \
	   $(CIRCLEHOME)/lib/fs/libfs.a \
	   $(CIRCLEHOME)/lib/libcircle.a

include $(CIRCLEHOME)/Rules.mk

$(CIRCLEHOME)/addon/SDCard/libsdcard.a:
	$(MAKE) -C $(CIRCLEHOME)/addon/SDCard

$(CIRCLEHOME)/addon/fatfs/libfatfs.a:
	$(MAKE) -C $(CIRCLEHOME)/addon/fatfs EXTRAINCLUDE=-I$(CURDIR)/fatfs_compat

-include $(DEPS)
