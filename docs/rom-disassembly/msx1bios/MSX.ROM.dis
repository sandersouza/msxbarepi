	ld l,000h
	inc h
	ld a,l
	sub e
	ld a,h
	sbc a,d
	jr nc,$+12

;=============================================================================
; === ROTINAS DE SLOT E PAGINACAO DE MEMORIA ===
;=============================================================================
; Suporte de baixo nivel ao mapeamento de paginas de 16KB.
; Gerencia a porta 0xA8 (slot primario) e endereco 0xFFFF (sub-slot).
;=============================================================================

	ex de,hl
	ld a,(0ffffh)
	cpl
	ld l,a
	in a,(0a8h)
	ld h,a
	ld sp,hl
	ld a,b
	and a
	jr z,$+10
	ld a,(0ffffh)
	cpl
	add a,040h
	jr nc,$-52
	in a,(0a8h)
	add a,040h
	jr nc,$-73
	ld hl,00000h
	add hl,sp
	ld a,h
	out (0a8h),a
