; =============================================================================
; BIOS_annotated.asm
; Disassembly da BIOS do MSX 1 — Gradiente Expert v1.1 (EXPERT11.ROM)
; Gerado por: z80dasm 1.1.6 + anotacoes manuais/automaticas
;
; Plataforma: MSX-1 (Gradiente Expert — clone brasileiro)
; CPU:        Zilog Z80A @ 3.58 MHz
; VDP:        TMS9918A / TMS9928A (video)
; PSG:        AY-3-8910 (audio, 3 canais)
; PPI:        Intel 8255 (teclado, joystick, cassete, slot ctrl)
; ROM:        32 KB (0x0000-0x7FFF no slot 0)
;
; NOTA SOBRE ENDERECOS:
;   O z80dasm adotou 'org 00100h' como base (offset +0x100).
;   Subtraia 0x0100 para obter enderecos fisicos reais do MSX.
;   Exemplo: endereco 0x0100 neste arquivo = fisico 0x0000 no MSX.
;
; MAPA DE MEMORIA DO MSX-1:
;   0x0000-0x7FFF  Main ROM (BIOS + BASIC) — slot 0
;   0x8000-0xBFFF  RAM (16KB minimo, ate 64KB expandida)
;   0xC000-0xFFFF  RAM sistema / cartuchos / expansoes
;   0xF380-0xFFFF  Work RAM (variaveis BIOS/BASIC)
;
; PORTAS DE I/O PRINCIPAIS:
;   0x98 — VDP data      0x99 — VDP control/status
;   0xA0 — PSG address   0xA1 — PSG write   0xA2 — PSG read
;   0xA8 — Slot select (PPI port A)
;   0xA9 — Keyboard (PPI port B)
;   0xAA — Keyboard row (PPI port C)
;   0xAB — PPI control register
; =============================================================================

; z80dasm 1.1.6
; command line: z80dasm EXPERT11.ROM

	org	00100h


;=============================================================================
; === VETORES RST / RESET E TABELA DE ENTRADA BIOS ===
;=============================================================================
; Primeiros 64 bytes (0x0100-0x013F = fisico 0x0000-0x003F):
; 8 vetores RST de 8 bytes cada.  Cada vetor pode conter ate 8 bytes
; de codigo inline ou um JP + NOPs de preenchimento.
; Em seguida, a tabela de entrada extendida da BIOS ocupa os bytes ate
; o handler de NMI em 0x0166.
;=============================================================================

; ────────────────────────────────────────────────────────────
; [00100h]  RESET
; RST 00H: Cold-boot / CHKRAM — DI + JP para init
; ────────────────────────────────────────────────────────────
	di
	jp 002d7h
	cp a
	dec de
	sbc a,b
	sbc a,b
; ────────────────────────────────────────────────────────────
; [00108h]  RST_08H
; RST 08H: SYNCHR — checa caractere de sintaxe BASIC
; ────────────────────────────────────────────────────────────
	jp 02683h
	nop
	jp 001b6h
	nop
; ────────────────────────────────────────────────────────────
; [00110h]  RST_10H
; RST 10H: RDSLT  — le byte de um slot especifico
; ────────────────────────────────────────────────────────────
	jp 02686h
	nop
	jp 001d1h
	nop
; ────────────────────────────────────────────────────────────
; [00118h]  RST_18H
; RST 18H: OUTDO  — envia char para dispositivo de saida atual
; ────────────────────────────────────────────────────────────
	jp 01b45h
	nop
	jp 00217h
	nop
; ────────────────────────────────────────────────────────────
; [00120h]  RST_20H
; RST 20H: CALSLT — chamada inter-slot
; ────────────────────────────────────────────────────────────
	jp 0146ah
	nop
	jp 0025eh
	nop
; ────────────────────────────────────────────────────────────
; [00128h]  RST_28H
; RST 28H: DCOMPR — compara HL e DE, seta flags
; ────────────────────────────────────────────────────────────
	jp 02689h
	ld hl,00011h
	nop
	nop
; ────────────────────────────────────────────────────────────
; [00130h]  RST_30H
; RST 30H: ENASLT — habilita slot de memoria
; ────────────────────────────────────────────────────────────
	jp 00205h
	nop
	nop
	nop
	nop
	nop
; ────────────────────────────────────────────────────────────
; [00138h]  RST_38H
; RST 38H: Handler de interrupcao primaria (IM 1)
; ────────────────────────────────────────────────────────────
	jp 00c3ch
	jp 0049dh
	jp 0139dh
	jp 00577h
	jp 00570h
	jp 0057fh
	jp 007d7h
	jp 007cdh
	jp 007ech
	jp 007dfh
	jp 00815h
	jp 0070fh
	jp 00744h
	jp 0084fh
	jp 007f7h
	nop

;=============================================================================
; === HANDLER NMI (TECLA PAUSE) ===
;=============================================================================
; Chamado pelo hardware ao pressionar PAUSE/STOP.
; Salva estado completo da CPU e suspende execucao ate nova tecla.
;=============================================================================

; ────────────────────────────────────────────────────────────
; [00166h]  INIMLT
; Inicializa MULTICOLOR (Screen 3)
; ────────────────────────────────────────────────────────────
	jp 01398h
	jp 006a8h
	jp 0050eh
	jp 00538h
