	jp 01492h
	jp 016c5h
	jp 016eeh
	jp 0175dh
; ────────────────────────────────────────────────────────────
; [00205h]  CALLF_IMPL
; Implementacao CALLF: chamada far (RST 30H hook)
; ────────────────────────────────────────────────────────────
	jp 0173ch
	jp 0172ah
	jp 0170ah
	jp 01599h
	jp 015dfh
	jp 01639h
; ────────────────────────────────────────────────────────────
; [00217h]  CALSLT_IMPL
; Implementacao CALSLT: chamada inter-slot
; ────────────────────────────────────────────────────────────
	jp 01640h
	jp 01676h
	jp 01647h
	jp 0167eh
	jp 01809h
	jp 018c7h
	jp 018cfh
	jp 018e4h
	jp 0197ah
	jp 00f3dh
	jp 00f7ah
	jp 0144ch
	jp 0144fh
	jp 01449h
	jp 01452h
	jp 0148ah
	jp 0148eh
	jp 0145fh
	jp 01b63h
	jp 01470h
	jp 01474h
	jp 00468h
	jp 001ffh
	xor l
	cp a
; ────────────────────────────────────────────────────────────
; [0025eh]  DCOMPR_IMPL
; Implementacao DCOMPR: compara HL e DE — Z=HL==DE, C=HL<DE
; ────────────────────────────────────────────────────────────
	and (hl)
	xor (hl)
	ret m
	pop af
	defb 0fdh,0e6h,0beh	;illegal sequence
	and a
	xor a
	xor h
	xor e
	cp d
	xor b
	adc a,a
	add a,h
	adc a,h
	or b
	add a,b
	sub b
	adc a,l
	adc a,c
	and l
	adc a,d
	adc a,(hl)
	or h
	adc a,e
	sbc a,d
	pop hl
	add a,l
	and b
	add a,e
	or c
	add a,a
	add a,d
	adc a,b
	and c
	and h
	and d
	sub e
	or l
	and e
	add a,c
	and c
	and a
	xor d
	xor e
	or b
	or c
	or d
	or l
	or (hl)
	cp d
	cp e
	cp h
	cp l
	cp (hl)
	cp a
	ret nz
	pop bc
	jp nz,0c7c3h
	ret
	jp z,0d1cdh
	out (0d4h),a
	push de
	jp c,0dfdch
	ret po
	pop hl
	jp po,0e7e3h
	jp (hl)
	jp pe,0f1edh
	di
	call p,0faf5h
	call m,0ffffh
	call 0027eh
	jp m,001c6h
	in a,(0a8h)
	ld d,a
	and c
	or b
	call 0f380h
	ld a,e
	ret
	push hl
	call 002a3h
	ex (sp),hl
	push bc
	call 001b6h
	jr $+29
	push de
	call 0027eh
	jp m,001e1h
	pop de

;=============================================================================
; === CHKRAM: DETECCAO E INICIALIZACAO DA RAM ===
;=============================================================================
; Executada no power-on/reset.  Testa cada slot para encontrar RAM.
; Determina tamanho da RAM disponivel, inicializa stack pointer,
; copia hook-table para RAM e salta para BASIC/MSX-SYSTEM.
;=============================================================================

; ────────────────────────────────────────────────────────────
; [002d7h]  CHKRAM_IMPL
; CHKRAM: detecta e inicializa RAM, testa slots de memoria
; ────────────────────────────────────────────────────────────
	in a,(0a8h)
	ld d,a
	and c
	or b
	jp 0f385h
	ex (sp),hl
	push hl
	call 002a3h
	pop de
	ex (sp),hl
	push bc
	call 001d1h
	pop bc
	ex (sp),hl
	push af
	ld a,b
	and 03fh
	or c
	out (0a8h),a
	ld a,l
	ld (0ffffh),a
	ld a,b
	out (0a8h),a
	pop af
	pop hl
	ret
	ld iy,(0fcc0h)
	jr $+20
	ex (sp),hl
	push af
	push de
	ld a,(hl)
	push af
	pop iy
	inc hl
	ld e,(hl)
	inc hl
	ld d,(hl)
	inc hl
	push de
	pop ix
	pop de
	pop af
	ex (sp),hl
	exx
	ex af,af'
	push iy
	pop af
	push ix
	pop hl
	call 0027eh
	jp m,0022eh
	in a,(0a8h)
	push af
	and c
	or b
	exx
	jp 0f38ch
	call 002a3h
	push af
	pop iy
	push hl
	push bc
	ld c,a
	ld b,000h
	ld a,l
	and h
	or d
	ld hl,0fcc5h
	add hl,bc
	ld (hl),a
	push hl
	ex af,af'
	exx
	call 00217h
	exx
	ex af,af'
	pop hl
	pop bc
	pop de
	ld a,b
	and 03fh
	or c
	di
	out (0a8h),a
	ld a,e
	ld (0ffffh),a
	ld a,b
	out (0a8h),a
	ld (hl),e
	ex af,af'
	exx
	ret
	call 0027eh
	jp m,0026bh
	in a,(0a8h)
	and c
	or b
	out (0a8h),a
	ret
	push hl
	call 002a3h
	ld c,a
	ld b,000h
	ld a,l
	and h
	or d
	ld hl,0fcc5h
	add hl,bc
	ld (hl),a
	pop hl
	ld a,c
	jr $-30
	di
	push af
	ld a,h
	rlca
	rlca
	and 003h
