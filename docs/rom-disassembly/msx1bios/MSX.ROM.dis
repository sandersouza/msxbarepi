	ld a,0c0h
	rlca
	rlca
	dec e
	jp p,00288h
	ld e,a
	cpl
	ld c,a
	pop af
	push af
	and 003h
	inc a
	ld b,a
	ld a,0abh
	add a,055h
	djnz $-2
	ld d,a
	and e
	ld b,a
	pop af
	and a
	ret
	push af
	ld a,d
	and 0c0h
	ld c,a
	pop af
	push af
	ld d,a
	in a,(0a8h)
	ld b,a
	and 03fh
	or c
	out (0a8h),a
	ld a,d
	rrca
	rrca
	and 003h
	ld d,a
	ld a,0abh
	add a,055h
	dec d
	jp p,002bbh
	and e
	ld d,a
	ld a,e
	cpl
	ld h,a
	ld a,(0ffffh)
	cpl
	ld l,a
	and h
	or d
	ld (0ffffh),a
	ld a,b
	out (0a8h),a
	pop af
	and 003h
	ret
	ld a,082h
	out (0abh),a
	xor a
	out (0a8h),a
	ld a,050h
	out (0aah),a
	ld de,0ffffh
	xor a
	ld c,a
	out (0a8h),a
	sla c
	ld b,000h
	ld hl,0ffffh
	ld (hl),0f0h
	ld a,(hl)
	sub 00fh
	jr nz,$+13
	ld (hl),a
	ld a,(hl)
