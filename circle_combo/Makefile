CIRCLEHOME = ../third_party/circle
STDLIB_SUPPORT = 1

COMBO_DEBUG_OVERLAY_DEFAULT ?= 1
COMBO_ENABLE_FMSX ?= 0
COMBO_TEST_TONE_DEFAULT ?= 0
COMBO_INITRAMFS_MOUNT ?= 1
COMBO_REQUIRE_CPIO_BIOS ?= 0
COMBO_DEBUG_OVERLAY_COMPACT ?= 1
COMBO_HARD_DISABLE_AUDIO ?= 0
COMBO_CARTA_ONLY ?= 0
COMBO_FMSX_AUDIO ?= 1
COMBO_EMBED_INITRAMFS ?= 0
COMBO_EMBEDDED_BIOS_PATH ?= ../roms/cbios/cbios_main_msx1_br.rom
COMBO_SUPPRESS_WARNINGS ?= 1
COMBO_FMSX_MSX1_TEXT80 ?= 1
COMBO_FMSX_RAMMAPPER_KB ?= 256
COMBO_FMSX_MEGARAM_KB ?= 256
COMBO_FMSX_MEGARAM_ENABLED ?= 1
COMBO_FMSX_CART_GUESS ?= 1
COMBO_FMSX_CARTA_MAPPER ?= 255
COMBO_FMSX_CARTB_MAPPER ?= 255
COMBO_FMSX_BOOT_PROFILE ?= 1
COMBO_BOOT_QUIET ?= 0
COMBO_DEFER_USB_INIT_FRAMES ?= 90
COMBO_DEFER_SETTINGS_LOAD_FRAMES ?= 0
COMBO_DEFER_INITRAMFS_FULL_MOUNT_FRAMES ?= 120
COMBO_SIZE_OPT ?= 1
COMBO_FMSX_BOOT_MINIMAL_STARTUP ?= 1
COMBO_ENABLE_DEBUG_OVERLAY ?= 1
COMBO_DEBUG_OVERLAY_STAGE ?= 1
COMBO_ENABLE_SETTINGS_SAVE_EXPERIMENTAL ?= 1
COMBO_MENU_DOUBLE_BUFFER ?= 1
COMBO_FMSX_SCC_BALANCE_PCT ?= 96
COMBO_FMSX_FMPAC_BALANCE_PCT ?= 92
COMBO_FMSX_FMPAC_ATTENUATION_PCT ?= 58
COMBO_FMSX_SYNC_SCC_FM_EVERY_8LINES ?= 1
COMBO_BUILD_BID ?=
COMBO_BUILD_OWNER ?=

CPPFLAGS += -DCOMBO_DEBUG_OVERLAY_DEFAULT=$(COMBO_DEBUG_OVERLAY_DEFAULT)
CPPFLAGS += -DCOMBO_ENABLE_FMSX=$(COMBO_ENABLE_FMSX)
CPPFLAGS += -DCOMBO_TEST_TONE_DEFAULT=$(COMBO_TEST_TONE_DEFAULT)
CPPFLAGS += -DCOMBO_INITRAMFS_MOUNT=$(COMBO_INITRAMFS_MOUNT)
CPPFLAGS += -DCOMBO_REQUIRE_CPIO_BIOS=$(COMBO_REQUIRE_CPIO_BIOS)
CPPFLAGS += -DCOMBO_DEBUG_OVERLAY_COMPACT=$(COMBO_DEBUG_OVERLAY_COMPACT)
CPPFLAGS += -DCOMBO_HARD_DISABLE_AUDIO=$(COMBO_HARD_DISABLE_AUDIO)
CPPFLAGS += -DCOMBO_CARTA_ONLY=$(COMBO_CARTA_ONLY)
CPPFLAGS += -DCOMBO_FMSX_AUDIO=$(COMBO_FMSX_AUDIO)
CPPFLAGS += -DCOMBO_EMBED_INITRAMFS=$(COMBO_EMBED_INITRAMFS)
CPPFLAGS += -DCOMBO_EMBEDDED_BIOS_PATH=\"$(COMBO_EMBEDDED_BIOS_PATH)\"
CPPFLAGS += -DCOMBO_SUPPRESS_WARNINGS=$(COMBO_SUPPRESS_WARNINGS)
CPPFLAGS += -DCOMBO_FMSX_MSX1_TEXT80=$(COMBO_FMSX_MSX1_TEXT80)
CPPFLAGS += -DCOMBO_FMSX_RAMMAPPER_KB=$(COMBO_FMSX_RAMMAPPER_KB)
CPPFLAGS += -DCOMBO_FMSX_MEGARAM_KB=$(COMBO_FMSX_MEGARAM_KB)
CPPFLAGS += -DCOMBO_FMSX_MEGARAM_ENABLED=$(COMBO_FMSX_MEGARAM_ENABLED)
CPPFLAGS += -DCOMBO_FMSX_CART_GUESS=$(COMBO_FMSX_CART_GUESS)
CPPFLAGS += -DCOMBO_FMSX_CARTA_MAPPER=$(COMBO_FMSX_CARTA_MAPPER)
CPPFLAGS += -DCOMBO_FMSX_CARTB_MAPPER=$(COMBO_FMSX_CARTB_MAPPER)
CPPFLAGS += -DCOMBO_FMSX_BOOT_PROFILE=$(COMBO_FMSX_BOOT_PROFILE)
CPPFLAGS += -DCOMBO_BOOT_QUIET=$(COMBO_BOOT_QUIET)
CPPFLAGS += -DCOMBO_DEFER_USB_INIT_FRAMES=$(COMBO_DEFER_USB_INIT_FRAMES)
CPPFLAGS += -DCOMBO_DEFER_SETTINGS_LOAD_FRAMES=$(COMBO_DEFER_SETTINGS_LOAD_FRAMES)
CPPFLAGS += -DCOMBO_DEFER_INITRAMFS_FULL_MOUNT_FRAMES=$(COMBO_DEFER_INITRAMFS_FULL_MOUNT_FRAMES)
CPPFLAGS += -DCOMBO_SIZE_OPT=$(COMBO_SIZE_OPT)
CPPFLAGS += -DCOMBO_FMSX_BOOT_MINIMAL_STARTUP=$(COMBO_FMSX_BOOT_MINIMAL_STARTUP)
CPPFLAGS += -DCOMBO_ENABLE_DEBUG_OVERLAY=$(COMBO_ENABLE_DEBUG_OVERLAY)
CPPFLAGS += -DCOMBO_DEBUG_OVERLAY_STAGE=$(COMBO_DEBUG_OVERLAY_STAGE)
CPPFLAGS += -DCOMBO_ENABLE_SETTINGS_SAVE_EXPERIMENTAL=$(COMBO_ENABLE_SETTINGS_SAVE_EXPERIMENTAL)
CPPFLAGS += -DCOMBO_MENU_DOUBLE_BUFFER=$(COMBO_MENU_DOUBLE_BUFFER)
CPPFLAGS += -DCOMBO_FMSX_SCC_BALANCE_PCT=$(COMBO_FMSX_SCC_BALANCE_PCT)
CPPFLAGS += -DCOMBO_FMSX_FMPAC_BALANCE_PCT=$(COMBO_FMSX_FMPAC_BALANCE_PCT)
CPPFLAGS += -DCOMBO_FMSX_FMPAC_ATTENUATION_PCT=$(COMBO_FMSX_FMPAC_ATTENUATION_PCT)
CPPFLAGS += -DCOMBO_FMSX_SYNC_SCC_FM_EVERY_8LINES=$(COMBO_FMSX_SYNC_SCC_FM_EVERY_8LINES)
CPPFLAGS += '-DCOMBO_BUILD_BID="$(COMBO_BUILD_BID)"'
CPPFLAGS += '-DCOMBO_BUILD_OWNER="$(COMBO_BUILD_OWNER)"'

ifeq ($(COMBO_SUPPRESS_WARNINGS),1)
CFLAGS += -w
CXXFLAGS += -w
endif

ifeq ($(COMBO_ENABLE_FMSX),1)
CFLAGS += -DFMSX_BAREMETAL_NO_START_RUN
CFLAGS += -DFMSX_BAREMETAL_SKIP_DISK_OPEN
CFLAGS += -DFMSX_BAREMETAL_SKIP_FDC_RESET
CFLAGS += -DFMSX_BAREMETAL_SKIP_BIOS_PATCHES
ifeq ($(COMBO_FMSX_AUDIO),0)
CFLAGS += -DFMSX_BAREMETAL_SKIP_AUDIO_RESET
CFLAGS += -DFMSX_BAREMETAL_SKIP_AUDIO_RUNTIME
endif
CFLAGS += -DFMSX_BAREMETAL_SIMPLE_REFRESHBORDER
ifeq ($(COMBO_HARD_DISABLE_AUDIO),1)
CFLAGS += -DFMSX_BAREMETAL_HARD_DISABLE_AUDIO
endif
ifeq ($(COMBO_CARTA_ONLY),1)
CFLAGS += -DFMSX_BAREMETAL_CARTA_ONLY
endif
ifeq ($(COMBO_FMSX_BOOT_MINIMAL_STARTUP),1)
CFLAGS += -DFMSX_BAREMETAL_BOOT_MINIMAL_STARTUP
endif
CFLAGS += -DSKIP_STDIO_REDEFINES
CFLAGS += -I ./fmsx_compat -I ../third_party/fmsx -I ../third_party/fmsx/fMSX -I ../third_party/fmsx/EMULib -I ../third_party/fmsx/Z80
endif

ifeq ($(COMBO_SIZE_OPT),1)
CFLAGS += -Os -ffunction-sections -fdata-sections
CXXFLAGS += -Os -ffunction-sections -fdata-sections
LDFLAGS += --gc-sections
endif

OBJS = main.o kernel.o keyboard_input.o gfx_textbox.o viewport_screenshot.o combo_menu.o combo_menu_items.o media_catalog.o combo_file_browser.o combo_debug_overlay.o
OBJS += combo_locale.o combo_locale_pt.o combo_locale_en.o combo_locale_es.o

ifeq ($(COMBO_ENABLE_FMSX),1)
OBJS += fmsx_runtime.o fmsx_host_stubs.o fmsx_compat_stubs.o fmsx_libc_shim.o
OBJS += fmsx_virtual_fs.o fmsx_initramfs.o
OBJS += fmsx_carts_sha_fallback.o
OBJS += fmsx_embedded_initramfs.o
OBJS += fmsx_embedded_roms.o
OBJS += fmsx_upstream_msx.o fmsx_upstream_v9938.o fmsx_upstream_z80.o
OBJS += fmsx_upstream_sound.o fmsx_upstream_sha1.o
OBJS += fmsx_upstream_fdidisk.o
OBJS += fmsx_upstream_i8255.o fmsx_local_ym2413.o fmsx_upstream_ay8910.o fmsx_local_scc.o fmsx_upstream_wd1793.o
OBJS += fmsx_upstream_opll.o fmsx_upstream_wrapnukeykt.o
endif

LIBS = $(CIRCLEHOME)/lib/sound/libsound.a \
	   $(CIRCLEHOME)/lib/sched/libsched.a \
	   $(CIRCLEHOME)/lib/usb/libusb.a \
	   $(CIRCLEHOME)/lib/input/libinput.a \
	   $(CIRCLEHOME)/addon/SDCard/libsdcard.a \
	   $(CIRCLEHOME)/addon/fatfs/libfatfs.a \
	   $(CIRCLEHOME)/lib/fs/libfs.a \
	   $(CIRCLEHOME)/lib/libcircle.a

include $(CIRCLEHOME)/Rules.mk

$(CIRCLEHOME)/addon/SDCard/libsdcard.a:
	$(MAKE) -C $(CIRCLEHOME)/addon/SDCard

$(CIRCLEHOME)/addon/fatfs/libfatfs.a:
	$(MAKE) -C $(CIRCLEHOME)/addon/fatfs EXTRAINCLUDE=-I$(CURDIR)/fatfs_compat

-include $(DEPS)
